# deploy/joda/.env lives ONLY on JODA (deploy.sh creates it on first run with
# random secrets; never commit, never rsync from the Mac). chmod 600.
POSTGRES_PASSWORD=changeme
# JODA's LAN address for the moderation queue (/admin); from the private infra notes.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8098
ALIENMATCH_ADMIN_TOKEN=changeme
ALIENMATCH_WS_ORIGINS=aliens.ol1n.com
# Mood scoring on SPARK via the LiteLLM gateway; empty = self-rating only.
ALIENMATCH_GATEWAY_URL=
ALIENMATCH_GATEWAY_KEY=
ALIENMATCH_VL_MODEL=vl
ALIENMATCH_ASR_MODEL=asr
# SPARK broker for on-demand models (empty = models assumed always on).
ALIENMATCH_BROKER_URL=
ALIENMATCH_BROKER_TOKEN=
