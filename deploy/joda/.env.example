# Copy to deploy/joda/.env ON JODA (never commit, never rsync from the Mac). chmod 600.
POSTGRES_PASSWORD=changeme
# JODA's LAN address (from the private infra notes); 127.0.0.1 if only Caddy on JODA calls it.
ALIENMATCH_BIND=127.0.0.1
ALIENMATCH_PORT=8096
# Browser origins allowed to open wall WebSockets (Flutter web), space-separated.
ALIENMATCH_WS_ORIGINS=
# Moderation queue at /admin (internal only). Empty = disabled.
ALIENMATCH_ADMIN_TOKEN=
# Mood scoring on SPARK via the LiteLLM gateway; empty = self-rating only.
ALIENMATCH_GATEWAY_URL=
ALIENMATCH_GATEWAY_KEY=
ALIENMATCH_VL_MODEL=vl
ALIENMATCH_ASR_MODEL=asr
