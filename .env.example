# Copy to .env. Never commit .env. Placeholders only: no LAN addresses, no real values.
MIMO_DATABASE_URL=postgres://mimo:changeme@db.example:5432/mimo?sslmode=disable
MIMO_ADDR=:8080
# Local development only: trusts the X-Mimo-User header. Never in production.
MIMO_DEV_AUTH=0
# Throwaway database for integration tests (DB trigger LOW x LOW).
MIMO_TEST_DATABASE_URL=
