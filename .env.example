# Copy to .env. Never commit .env. Placeholders only: no LAN addresses, no real values.
ALIENMATCH_DATABASE_URL=postgres://alienmatch:changeme@db.example:5432/alienmatch?sslmode=disable
ALIENMATCH_ADDR=:8080
# Local development only: trusts the X-AlienMatch-User header. Never in production.
ALIENMATCH_DEV_AUTH=0
# Throwaway database for integration tests (DB trigger LOW x LOW).
ALIENMATCH_TEST_DATABASE_URL=
